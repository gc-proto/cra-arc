{% capture crlf %}
{% endcapture %}
{%- assign site_pages = "" | split: "" -%}
{%- assign static_files = "" | split: "" -%}

{%- if include.extensions != nil -%}
  {%- if include.extensions != "" -%}
    {%- assign ext_arr = include.extensions | strip | split: ", " -%}

    {%- for item in site.static_files -%}
      {%- for extname in ext_arr -%}
        {%- assign ext_len = extname.size -%}
        {%- assign ext_start_pos = 0 | minus: extname.size -%}
        {%- assign current_ext = item.path | slice: ext_start_pos, ext_len -%}
        {%- if current_ext == extname -%}
          {%- assign static_files = static_files | push: item -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- else -%}
    {%- assign static_files = site.static_files -%}
  {%- endif -%}
{%- endif -%}
{%- assign site_pages = site.pages -%}

{%- if include.section and include.section != "" -%}
  {%- assign sections = include.section | split: "," -%}
  
  {%- assign matched_static_paths = "" -%}
  {%- assign matched_page_paths = "" -%}

  {%- for item in static_files -%}
    {%- for section in sections -%}
      {%- assign folder_prefix = section | strip | append: "/" -%}
      {%- assign path_start = item.path | slice: 0, folder_prefix.size -%}
      
      {%- if path_start == folder_prefix -%}
        {%- assign matched_static_paths = matched_static_paths | append: item.path | append: "||" -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}

  {%- for item in site_pages -%}
    {%- for section in sections -%}
      {%- assign folder_prefix = section | strip | append: "/" -%}
      {%- assign path_start = item.path | slice: 0, folder_prefix.size -%}
      
      {%- if path_start == folder_prefix -%}
        {%- assign matched_page_paths = matched_page_paths | append: item.path | append: "||" -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}

  {%- assign valid_static_paths = matched_static_paths | split: "||" -%}
  {%- assign valid_page_paths = matched_page_paths | split: "||" -%}

  {%- assign static_files = static_files | where_exp: "item", "valid_static_paths contains item.path" -%}
  {%- assign site_pages = site_pages | where_exp: "item", "valid_page_paths contains item.path" -%}
{%- endif -%}

{%- if static_files == nil -%}
  {%- assign static_files = "" | split: "," -%}
{%- endif -%}

{%- if site_pages == nil -%}
  {%- assign site_pages = "" | split: "," -%}
{%- endif -%}

{%- assign all_pages = static_files | concat: site_pages -%}

{%- if all_pages.size > 0 -%}
  <ul id="{{ include.tree_id }}" class="list-unstyled wb-treeview" role="tree"{%- if include.tree_label and include.tree_label != "" -%} aria-labelledby="{{ include.tree_label }}"{%- endif -%}>{{ crlf }}
{%- assign path_string_list = "" -%}
{%- for p in all_pages -%}
  {%- if p.sitemap == false or p.sitemapExclude == true -%}{%- continue -%}{%- endif -%}
  {%- if p.url -%}
    {%- assign target_path = p.url -%}
  {%- else -%}
    {%- assign target_path = p.path -%}
  {%- endif -%}
  {%- assign first_char = target_path | slice: 0 -%}
  {%- if first_char != "/" -%}
    {%- assign target_path = target_path | prepend: "/" -%}
  {%- endif -%}
  {%- if path_string_list == "" -%}
    {%- assign path_string_list = target_path -%}
  {%- else -%}
    {%- assign path_string_list = path_string_list | append: "||" | append: target_path -%}
  {%- endif -%}
{%- endfor -%}

{%- assign sorted_paths = path_string_list | split: "||" | sort -%}
{%- assign open_folders = "" | split: "," -%}
{%- assign physical_html_depth = 0 -%}

{%- for active_path in sorted_paths -%}
  {%- assign p = nil -%}
  {%- for item in all_pages -%}
    {%- if item.url == active_path or item.path == active_path -%}
      {%- assign p = item -%}
      {%- break -%}
    {%- else -%}
      {%- assign clean_item_path = item.path -%}
      {%- assign check_char = clean_item_path | slice: 0 -%}
      {%- if check_char != "/" -%}
        {%- assign clean_item_path = clean_item_path | prepend: "/" -%}
      {%- endif -%}
      {%- if clean_item_path == active_path -%}
        {%- assign p = item -%}
        {%- break -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if p == nil -%}{%- continue -%}{%- endif -%}
  {%- assign current_loop_path = active_path -%}
  {%- assign last_char = current_loop_path | slice: -1 -%}
  {%- if last_char == "/" -%}
    {%- assign current_loop_path = current_loop_path | append: "index.html" -%}
  {%- endif -%}
  {%- assign url_parts = current_loop_path | split: "/" -%}
  {%- assign parts_size = url_parts.size -%}
  {%- assign filename = url_parts | last -%}
  {%- assign target_folder_depth = parts_size | minus: 2 -%}
  {%- assign this_page_folders = "" | split: "," -%}
  {%- if target_folder_depth > 0 -%}
    {%- for i in (1..target_folder_depth) -%}
      {%- if url_parts[i] != "" and url_parts[i] != nil -%}
        {%- assign this_page_folders = this_page_folders | push: url_parts[i] -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- assign keep_open_count = 0 -%}
  {%- assign max_possible_match = open_folders.size -%}
  {%- if this_page_folders.size < max_possible_match -%}
    {%- assign max_possible_match = this_page_folders.size -%}
  {%- endif -%}
  {%- if max_possible_match > 0 -%}
    {%- assign loop_end = max_possible_match | minus: 1 -%}
    {%- for i in (0..loop_end) -%}
      {%- assign old_f = open_folders[i] -%}
      {%- assign new_f = this_page_folders[i] -%}
      {%- if old_f == new_f -%}
        {%- assign keep_open_count = keep_open_count | plus: 1 -%}
      {%- else -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- assign current_open_num = open_folders.size -%}
  {%- if current_open_num > keep_open_count -%}
    {%- assign levels_to_close = current_open_num | minus: keep_open_count -%}
    {%- for c in (1..levels_to_close) -%}
      {%- if physical_html_depth > 0 -%}
        </ul>{{ crlf }}
      </li>{{ crlf }}
        {%- assign physical_html_depth = physical_html_depth | minus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- assign temp_folders = "" | split: "," -%}
    {%- if keep_open_count > 0 -%}
      {%- assign loop_end = keep_open_count | minus: 1 -%}
      {%- for i in (0..loop_end) -%}
        {%- assign temp_folders = temp_folders | push: open_folders[i] -%}
      {%- endfor -%}
    {%- endif -%}
    {%- assign open_folders = temp_folders -%}
  {%- endif -%}
  {%- assign start_index = open_folders.size -%}
  {%- assign end_index = this_page_folders.size -%}
  {%- if start_index < end_index -%}
    {%- assign loop_end = end_index | minus: 1 -%}
    {%- for i in (start_index..loop_end) -%}
      {%- assign folder_name = this_page_folders[i] -%}
      {%- assign open_folders = open_folders | push: folder_name -%}
      {%- assign physical_html_depth = physical_html_depth | plus: 1 -%}
  <li role="treeitem" aria-expanded="true" aria-selected="false" class="tv-parent" aria-level="{{ physical_html_depth }}">
    <span class="tv-title">{{ folder_name }}</span>
    <ul role="group">{{ crlf }}
    {%- endfor -%}
  {%- endif -%}
  {%- assign display_label = filename -%}
  {%- assign leaf_level = physical_html_depth | plus: 1 -%}
  {%- if is_trailing_slash and p == nil -%}
    {%- assign original_slash_path = active_path | replace: "index.html", "" -%}
    {%- for item in all_pages -%}
      {%- if item.url == original_slash_path or item.path == original_slash_path -%}
        {%- assign p = item -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if p.url -%}
      <li role="treeitem" aria-selected="false" aria-level="{{ leaf_level }}" data-action-id="default" class="nowrap tv-list"><span class="tv-filtered"><a tabindex="-1" target="_blank" class="tv-page-link" data-exit="false" lang="{{ page.lang | default: "en" }}" href="{{ p.url | relative_url }}"{%- if p.title -%} title="{{ p.title | escape }}"{%- endif -%}>{{ display_label | escape }}</a>{%- if p.title -%}<span class="tv-page-title wb-inv" aria-hidden="true">{{ p.title | escape }}</span>{%- endif -%}</span></li>{{ crlf }}
  {%- else -%}
      <li role="treeitem" aria-selected="false" aria-level="{{ leaf_level }}" data-action-id="static" class="nowrap tv-list"><span class="label label-default position-relative tv-type">static</span><span class="tv-filtered"><a tabindex="-1" target="_blank" class="tv-page-link" data-exit="false" href="{{ p.path | relative_url }}">{{ display_label | escape }}</a></span></li>{{ crlf }}
  {%- endif -%}
{%- endfor -%}
{%- if physical_html_depth > 0 -%}
  {%- for i in (1..physical_html_depth) -%}
    </ul>{{ crlf }}
  </li>{{ crlf }}
  {%- endfor -%}
{%- endif -%}
</ul>{{ crlf }}
{%- endif -%}